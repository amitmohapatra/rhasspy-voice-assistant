# =============================================================================
# Rhasspy Voice Assistant - Production Azure Deployment
# =============================================================================
# Template for real Azure deployment. Copy to .env and fill in values.
# =============================================================================

APP_ENV=production
DEBUG=false
SECRET_KEY=<generate-a-strong-secret-key>

# Storage: Real Azure Blob Storage
STORAGE_TYPE=azure_blob
AZURE_STORAGE_CONTAINER=rhasspy-documents
# Option 1: Connection string (simplest)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
# Option 2: Account name + key
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key
# Option 3: Account name only (uses DefaultAzureCredential / Managed Identity)
# AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount

# Database: Azure Database for PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@your-server.postgres.database.azure.com:5432/rhasspy

# Cache: Azure Cache for Redis
REDIS_URL=rediss://your-cache.redis.cache.windows.net:6380/0
CELERY_BROKER_URL=rediss://your-cache.redis.cache.windows.net:6380/1

# Vector Database: Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# LLM Keys
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# Inference Service
INFERENCE_SERVICE_URL=https://inference.your-domain.com

# JWT
JWT_SECRET_KEY=<generate-a-strong-jwt-secret>

# Encryption
ENCRYPTION_KEY=<generate-with-fernet>

# CORS (update for your domain)
CORS_ORIGINS=["https://your-domain.com"]
