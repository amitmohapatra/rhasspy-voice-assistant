# =============================================================================
# Rhasspy Voice Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#
# For LOCAL DEVELOPMENT: Use defaults (local storage, local Postgres/Redis)
# For PRODUCTION (AWS): Configure S3, RDS, ElastiCache, Qdrant Cloud
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=Rhasspy Voice Assistant
APP_ENV=development                    # development | staging | production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local: Use docker-compose PostgreSQL
# Production: Use AWS RDS PostgreSQL
DATABASE_URL=postgresql+asyncpg://rhasspy:rhasspy_secret@localhost:5432/rhasspy
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Redis (Caching, Sessions, Celery)
# -----------------------------------------------------------------------------
# Local: Use docker-compose Redis
# Production: Use AWS ElastiCache
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Vector Database (Qdrant - Recommended)
# -----------------------------------------------------------------------------
# Local: Use docker-compose Qdrant
# Production: Use Qdrant Cloud (https://cloud.qdrant.io)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # Required for Qdrant Cloud

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Options: "local", "s3", "azure_blob", "gcs"
# For cloud-specific env files, see: .env.local, .env.aws, .env.azure, .env.gcp
STORAGE_TYPE=local
STORAGE_PATH=./storage                 # For local storage only

# -----------------------------------------------------------------------------
# AWS Configuration (S3 / LocalStack)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=rhasspy-documents
S3_ENDPOINT_URL=                       # For LocalStack: http://localstack:4566
S3_USE_SSL=true                        # Set to false for LocalStack

# -----------------------------------------------------------------------------
# Azure Blob Storage (Azurite)
# -----------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=       # Full connection string (preferred)
AZURE_STORAGE_CONTAINER=              # Container name
AZURE_STORAGE_ACCOUNT_NAME=           # Storage account name
AZURE_STORAGE_ACCOUNT_KEY=            # Storage account key
AZURE_STORAGE_ENDPOINT_URL=           # For Azurite emulator

# -----------------------------------------------------------------------------
# GCP Cloud Storage (fake-gcs-server)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=
GCP_CREDENTIALS_JSON=                  # Path to service account JSON
GCP_STORAGE_ENDPOINT_URL=             # For fake-gcs-server: http://gcp-storage:4443

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
COHERE_API_KEY=                        # For Cohere embeddings
VOYAGE_API_KEY=                        # For Voyage embeddings

# Default LLM Settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIMENSIONS=1536

# -----------------------------------------------------------------------------
# Audio (TTS/STT)
# -----------------------------------------------------------------------------
TTS_PROVIDER=openai
TTS_MODEL=tts-1
TTS_VOICE=nova
STT_PROVIDER=openai
STT_MODEL=whisper-1

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# Inference Service
# -----------------------------------------------------------------------------
INFERENCE_SERVICE_URL=http://localhost:8001   # Docker: http://inference:8001
INFERENCE_SERVICE_TIMEOUT=600                 # Seconds (large docs take time on CPU)

# -----------------------------------------------------------------------------
# Encryption (for storing sensitive data in DB)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=                        # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_SALT=rhasspy-voice-assistant-salt

# =============================================================================
# Production AWS Architecture Reference
# =============================================================================
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │                         AWS Production Setup                            │
# ├─────────────────────────────────────────────────────────────────────────┤
# │                                                                         │
# │  ECS Fargate          → Backend containers (auto-scaling)              │
# │  Application LB       → Load balancing + SSL termination               │
# │  RDS PostgreSQL       → DATABASE_URL (Multi-AZ for HA)                 │
# │  ElastiCache Redis    → REDIS_URL (cluster mode)                       │
# │  S3                   → Document/file storage                          │
# │  Qdrant Cloud         → Vector search (or self-hosted on EC2)          │
# │  Secrets Manager      → API keys (optional, can use env vars)          │
# │  CloudWatch           → Logging and monitoring                         │
# │  Route 53             → DNS                                             │
# │  CloudFront           → CDN for static assets (optional)               │
# │                                                                         │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Production environment variables would look like:
#
# APP_ENV=production
# DEBUG=false
# DATABASE_URL=postgresql+asyncpg://user:pass@your-rds.region.rds.amazonaws.com:5432/rhasspy
# REDIS_URL=redis://your-elasticache.region.cache.amazonaws.com:6379/0
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-qdrant-cloud-api-key
# STORAGE_TYPE=s3
# S3_BUCKET=your-production-bucket
# AWS_REGION=us-east-1
# (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY use IAM role, not needed)
#
# =============================================================================
