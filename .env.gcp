# =============================================================================
# Rhasspy Voice Assistant - GCP Emulation (fake-gcs-server)
# =============================================================================
# Local development with Cloud Storage emulated via fake-gcs-server.
# Usage: make up-gcp
# =============================================================================

APP_ENV=development
DEBUG=true
SECRET_KEY=local-dev-secret-key

# Storage: GCS via fake-gcs-server
STORAGE_TYPE=gcs
GCP_STORAGE_BUCKET=rhasspy-documents
GCP_PROJECT_ID=test-project
GCP_STORAGE_ENDPOINT_URL=http://gcp-storage:4443

# Database
POSTGRES_USER=rhasspy
POSTGRES_PASSWORD=rhasspy_secret
POSTGRES_DB=rhasspy

# Inference Service
INFERENCE_SERVICE_URL=http://inference:8001

# LLM Keys (fill in your own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
