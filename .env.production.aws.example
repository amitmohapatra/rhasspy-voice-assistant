# =============================================================================
# Rhasspy Voice Assistant - Production AWS Deployment
# =============================================================================
# Template for real AWS deployment. Copy to .env and fill in values.
# =============================================================================

APP_ENV=production
DEBUG=false
SECRET_KEY=<generate-a-strong-secret-key>

# Storage: Real AWS S3
STORAGE_TYPE=s3
S3_BUCKET=your-production-bucket
S3_USE_SSL=true
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY should use IAM roles in production.
# Only set these if not using IAM roles:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Database: AWS RDS PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@your-rds-endpoint.rds.amazonaws.com:5432/rhasspy

# Cache: AWS ElastiCache Redis
REDIS_URL=redis://your-elasticache-endpoint.cache.amazonaws.com:6379/0
CELERY_BROKER_URL=redis://your-elasticache-endpoint.cache.amazonaws.com:6379/1

# Vector Database: Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# LLM Keys
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# Inference Service
INFERENCE_SERVICE_URL=https://inference.your-domain.com

# JWT
JWT_SECRET_KEY=<generate-a-strong-jwt-secret>

# Encryption
ENCRYPTION_KEY=<generate-with-fernet>

# CORS (update for your domain)
CORS_ORIGINS=["https://your-domain.com"]
