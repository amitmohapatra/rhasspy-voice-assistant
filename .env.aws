# =============================================================================
# Rhasspy Voice Assistant - AWS Emulation (LocalStack)
# =============================================================================
# Local development with S3 emulated via LocalStack.
# Usage: make up-aws
# =============================================================================

APP_ENV=development
DEBUG=true
SECRET_KEY=local-dev-secret-key

# Storage: S3 via LocalStack
STORAGE_TYPE=s3
S3_BUCKET=rhasspy-documents
S3_ENDPOINT_URL=http://localstack:4566
S3_USE_SSL=false
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Database
POSTGRES_USER=rhasspy
POSTGRES_PASSWORD=rhasspy_secret
POSTGRES_DB=rhasspy

# Inference Service
INFERENCE_SERVICE_URL=http://inference:8001

# LLM Keys (fill in your own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
