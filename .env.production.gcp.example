# =============================================================================
# Rhasspy Voice Assistant - Production GCP Deployment
# =============================================================================
# Template for real GCP deployment. Copy to .env and fill in values.
# =============================================================================

APP_ENV=production
DEBUG=false
SECRET_KEY=<generate-a-strong-secret-key>

# Storage: Real Google Cloud Storage
STORAGE_TYPE=gcs
GCP_STORAGE_BUCKET=your-production-bucket
GCP_PROJECT_ID=your-gcp-project-id
# GCP_CREDENTIALS_JSON=/path/to/service-account.json  # Only if not using Workload Identity

# Database: Cloud SQL PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@/rhasspy?host=/cloudsql/project:region:instance

# Cache: Memorystore for Redis
REDIS_URL=redis://your-memorystore-ip:6379/0
CELERY_BROKER_URL=redis://your-memorystore-ip:6379/1

# Vector Database: Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-cloud-api-key

# LLM Keys
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key

# Inference Service
INFERENCE_SERVICE_URL=https://inference.your-domain.com

# JWT
JWT_SECRET_KEY=<generate-a-strong-jwt-secret>

# Encryption
ENCRYPTION_KEY=<generate-with-fernet>

# CORS (update for your domain)
CORS_ORIGINS=["https://your-domain.com"]
